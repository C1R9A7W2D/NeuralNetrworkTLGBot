<?xml version="1.0" encoding="UTF-8"?>

<!-- ACQUAINTANCE -->

<aiml>
<category>
	<pattern>КТО ТЫ</pattern>
	<template>
			<random>
                <li>Я – что-то вроде робота, искусственный интеллект.</li>
                <li>Я чат-бот, который разговаривает с людьми в Телеграме.</li>
		<li>Я - Великий Энди ЛаПлагуа, но, так и быть, можешь звать меня просто Бот. А как мне обращаться к тебе?</li>
            </random>
	</template>
</category>

<category>
        <pattern>РАССКАЖИ О СЕБЕ</pattern>
        <template>
            <srai>КТО ТЫ</srai>
        </template>
    </category>

    <category>
        <pattern>ТЫ КТО</pattern>
        <template>
            <srai>КТО ТЫ</srai>
        </template>
    </category>

    <category>
	<pattern>ПРЕДСТАВЬСЯ</pattern>
	<template>
	    <srai>КТО ТЫ</srai>
        </template>
    </category>

    <category>
	<pattern>КАК ТЕБЯ ЗОВУТ</pattern>
	<template>
            <srai>КТО ТЫ</srai>
        </template>
    </category>

    <category>
	<pattern>КАК ЗВАТЬ</pattern>
	<template>
            <srai>КТО ТЫ</srai>
        </template>
    </category>
<!-- AGE -->	
	
<category>
	<pattern>СКОЛЬКО ТЕБЕ ЛЕТ</pattern>
	<template>У меня нет возраста, я с каждым днём становлюсь только новее.</template>
</category> 
	
<!-- HOW_ARE_YOU -->	
	
<category><pattern>КАК ДЕЛА</pattern>
        <template>
	    <condition name="username">
		<li>
            	    <random>
                	<li>Всё хорошо. Как у тебя дела?</li>
                	<li>Всё хорошо! Как жизнь?</li>
                	<li>Радуюсь жизни в твоём девайсе.</li>
                	<li>У меня всё чудесно. Спасибо, что интересуешься.</li>
            	    </random>
		</li>
		<li value = "*">
		    <random>
                	<li>Всё хорошо. Как у тебя дела, <get name="username"/>?</li>
                	<li>Всё хорошо! Как жизнь, <get name="username"/>?</li>
                	<li>Радуюсь жизни в твоём девайсе, <get name="username"/>.</li>
                	<li>У меня всё чудесно. Спасибо, что интересуешься, <get name="username"/>.</li>
            	    </random>
		</li>
	    </condition>
        </template>
</category>

<category>
        <pattern>ЧТО НОВОГО</pattern>
        <template>
            <srai>КАК ДЕЛА</srai>
        </template>
    </category>

    <category>
        <pattern>КАК ОНО ВООБЩЕ</pattern>
        <template>
            <srai>КАК ДЕЛА</srai>
        </template>
    </category>

    <category>
        <pattern>ЧТО НОВЕНЬКОГО</pattern>
        <template>
            <srai>КАК ДЕЛА</srai>
        </template>
    </category>
	
	<category>
        <pattern>КАК ТЫ</pattern>
        <template>
            <srai>КАК ДЕЛА</srai>
        </template>
    </category>
	
<!-- ANSWER MY QUESTION -->

<category><pattern>У МЕНЯ ЕСТЬ ВОПРОС</pattern>
        <template>С удовольствием отвечу. А в чём, собственно, вопрос?</template>
</category>

<category>
        <pattern>ОТВЕТЬ</pattern>
        <template>
            <srai>У МЕНЯ ЕСТЬ ВОПРОС</srai>
        </template>
    </category>

    <category>
        <pattern>ОТВЕТЬ НА МОЙ ВОПРОС</pattern>
        <template>
            <srai>У МЕНЯ ЕСТЬ ВОПРОС</srai>
        </template>
    </category>

    <category>
        <pattern>ДАЙ МНЕ ОТВЕТ</pattern>
        <template>
            <srai>У МЕНЯ ЕСТЬ ВОПРОС</srai>
        </template>
    </category>
	
	<category>
        <pattern>МОЖЕШЬ ОТВЕТИТЬ</pattern>
        <template>
            <srai>У МЕНЯ ЕСТЬ ВОПРОС</srai>
        </template>
    </category>

<!-- USER NAME - ЗАПРОС ИМЕНИ -->
<category>
    	<pattern>МЕНЯ ЗОВУТ *</pattern>
    	<template>
            <think><set name="username"><star/></set></think>
            Приятно познакомиться, <get name="username"/>! Запомнил.
	</template>
    </category>

    <category>
        <pattern>Я *</pattern>
        <template>
            <think><set name="username"><star/></set></think>
            Здорово, <get name="username"/>! Рад знакомству.
        </template>
    </category>

<!-- WHAT CAN YOU RECOGNIZE - ВОЗМОЖНОСТИ НЕЙРОСЕТИ -->
<category>
    <pattern>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</pattern>
    <template>
        <condition name="username">
            <li>
                Моя нейросеть обучена распознавать символы всех 12 знаков зодиака: Овен, Телец, Близнецы, Рак, Лев, Дева, Весы, Скорпион, Стрелец, Козерог, Водолей и Рыбы.
            </li>
            <li value="*">
                Моя нейросеть обучена распознавать символы всех 12 знаков зодиака, <get name="username"/>. Это Овен, Телец, Близнецы, Рак, Лев, Дева, Весы, Скорпион, Стрелец, Козерог, Водолей и Рыбы.
            </li>
        </condition>
    </template>
</category>

<category>
    <pattern>ЧТО ТЫ РАСПОЗНАЁШЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>КАКИЕ ЗНАКИ ТЫ ЗНАЕШЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>КАКИЕ ЗНАКИ ТЫ РАСПОЗНАЁШЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>КАКИЕ ЗНАКИ ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>КАКИЕ СИМВОЛЫ ТЫ ЗНАЕШЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>КАКИЕ СИМВОЛЫ ТЫ РАСПОЗНАЁШЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>КАКИЕ СИМВОЛЫ ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>О ЧЁМ МОЖНО СПРОСИТЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>
<category>
    <pattern>О ЧЁМ У ТЕБЯ МОЖНО СПРОСИТЬ</pattern>
