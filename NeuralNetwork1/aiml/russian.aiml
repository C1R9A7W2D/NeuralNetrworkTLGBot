    <pattern>О ЧЁМ Я ТЕБЯ МОГУ СПРОСИТЬ</pattern>
    <template>
        <srai>ЧТО ТЫ УМЕЕШЬ РАСПОЗНАВАТЬ</srai>
    </template>
</category>

<!-- TELL ME ABOUT [SIGN] - РАССКАЗ О КОНКРЕТНОМ ЗНАКЕ. -->
<!-- ШАБЛОН: Запоминаем знак (last_sign) и даём первый факт. -->
<category>
    <pattern>РАССКАЖИ О *</pattern>
    <template>
        <think><set name="last_sign"><star/></set></think>
        <condition name="last_sign">
            <!-- ОВЕН -->
            <li value="ОВЕН|ОВНА|ОВНЕ">
                <condition name="username">
                    <li>Овен — первый знак зодиака, огненный, управляемый Марсом. Его символ — баран, олицетворяющий напор и упрямство.</li>
                    <li value="*">Овен — первый знак зодиака, огненный, управляемый Марсом, <get name="username"/>. Его символ — баран, олицетворяющий напор и упрямство.</li>
                </condition>
            </li>
            <!-- ТЕЛЕЦ -->
            <li value="ТЕЛЕЦ|ТЕЛЬЦА|ТЕЛЬЦЕ">
                <condition name="username">
                    <li>Телец — земной знак, находящийся под покровительством Венеры. Его символ — бык, обозначающий силу, устойчивость и иногда упрямство.</li>
                    <li value="*">Телец — земной знак, находящийся под покровительством Венеры, <get name="username"/>. Его символ — бык, обозначающий силу, устойчивость и иногда упрямство.</li>
                </condition>
            </li>
            <!-- БЛИЗНЕЦЫ -->
            <li value="БЛИЗНЕЦЫ|БЛИЗНЕЦОВ|БЛИЗНЕЦАХ">
                <condition name="username">
                    <li>Близнецы — воздушный знак, управляемый Меркурием. Символ — римская цифра II, часто изображаемая как близнецы, что означает двойственность, общительность и любопытство.</li>
                    <li value="*">Близнецы — воздушный знак, управляемый Меркурием, <get name="username"/>. Символ — римская цифра II, часто изображаемая как близнецы, что означает двойственность, общительность и любопытство.</li>
                </condition>
            </li>
	    <!-- РАК -->
            <li value="РАК|РАКА|РАКЕ">
                <condition name="username">
                    <li>Рак — водный знак, управляемый Луной. Символ — клешни рака или же символ бесконечности. Олицетворяет дом, семью и подсознание.</li>
                    <li value="*">Знаешь, <get name="username"/>, Рак — водный знак, управляемый Луной. Символ — клешни рака или же символ бесконечности. Олицетворяет дом, семью и подсознание.</li>
                </condition>
            </li>
	    <!-- ЛЕВ -->
            <li value="ЛЕВ|ЛЬВА|ЛЬВЕ">
                <condition name="username">
                    <li>Огненный знак под покровительством Солнца. Символ - голова и хвост льва - царя зверей в астрологии. Львы — амбициозные, творческие, щедрые, любят быть в центре внимания. Им присущи благородство и потребность в признании.</li>
                    <li>Это, <get name="username"/>, огненный знак под покровительством Солнца. Символ - голова и хвост льва - царя зверей в астрологии. Львы — амбициозные, творческие, щедрые, любят быть в центре внимания. Им присущи благородство и потребность в признании.</li>
                </condition>
            </li>
	    <!-- ДЕВА -->
            <li value="ДЕВА|ДЕВЫ|ДЕВЕ">
                <condition name="username">
                    <li>Дева - земной знак, управляемый Меркурием. Символ - Стилизованные инициалы «MV» (Maria Virgo — Дева Мария) или связанные колосья (богиня плодородия). Знак анализа, служения и совершенства.</li>
                    <li>Дева - земной знак, управляемый Меркурием. Символ - Стилизованные инициалы «MV» (Maria Virgo — Дева Мария) или связанные колосья (богиня плодородия). Знак анализа, служения и совершенства. Понял, <get name="username"/>!?</li>
                </condition>
            </li>
	    <!-- ВЕСЫ -->
	    <li value="ВЕСЫ|ВЕСОВ|ВЕСАХ">
                <condition name="username">
                    <li>Весы - это воздушный знак, управляемый Венерой. Изображает атрибут богини справедливости Фемиды, символ равновесия, справедливости и партнерства.</li>
                    <li>Весы - это воздушный знак, управляемый Венерой. Изображает атрибут богини справедливости Фемиды, символ равновесия, справедливости и партнерства. А теперь спроси что-нибудь поинтереснее, <get name="username"/>.</li>
                </condition>
            </li>
	    <!-- СКОРПИОН -->
	    <li value="СКОРПИОН|СКОРПИОНА|СКОРПИОНЕ|СКОРПИ">
                <condition name="username">
                    <li>Скорпион - водный знак под Плутоном и Марсом одновременно. Изображает стилизованную букву «M» с жалом (скорпион, убивший Ориона или напугавший Фаэтона). Символ трансформации, страсти и тайны.</li>
                    <li>Скорпион - водный знак под Плутоном и Марсом одновременно, представляешь, <get name="username"/>? Изображает стилизованную букву «M» с жалом (скорпион, убивший Ориона или напугавший Фаэтона). Символ трансформации, страсти и тайны.</li>
                </condition>
            </li>
	    <!-- СТРЕЛЕЦ -->
	    <li value="СТРЕЛЕЦ|СТРЕЛЬЦА|СТРЕЛЬЦЕ">
                <condition name="username">
                    <li>Что интересно, огненный знак под Юпитером. Символ - стрела кентавра (чаще всего Хирона), олицетворяет приключения, прямолинейность и расширение горизонтов.</li>
                    <li>Знаешь, что интересно, <get name="username"/>? То, что Стрелец - огненный знак под Юпитером. Символ - стрела кентавра (чаще всего Хирона), олицетворяет приключения, прямолинейность и расширение горизонтов.</li>
                </condition>
            </li>
	    <!-- КОЗЕРОГ -->
	    <li value="КОЗЕРОГ|КОЗЕРОГА|КОЗЕРОГЕ">
                <condition name="username">
                    <li>Как ни странно, земной знак, чьим покровителем является Сатурн. Выглядит как стилизованное изображение морского козла (коза Амалфея, вскормившая Зевса). Символ амбиций, дисциплины и высот.</li>
		    <li>Как ни странно, земной знак, чьим покровителем является Сатурн. Представляешь, <get name="username"/>? Выглядит как стилизованное изображение морского козла (коза Амалфея, вскормившая Зевса). Символ амбиций, дисциплины и высот.</li>
                </condition>
            </li>
	    <!-- ВОДОЛЕЙ -->
	    <li value="ВОДОЛЕЙ|ВОДОЛЕЯ|ВОДОЛЕЕ">
                <condition name="username">
                    <li>Почему-то не водный, а воздушный знак. Покровители - Уран и Сатурн. Изображает волны воды - символ оригинальности, гуманизма и прогресса.</li>
		    <li>Странно, <get name="username"/>... Почему-то Водолей не водный, а воздушный знак. Покровители - Уран и Сатурн. Изображает волны воды - символ оригинальности, гуманизма и прогресса.</li>
                </condition>
            </li>
	    <!-- РЫБЫ -->
	    <li value="РЫБЫ|РЫБ|РЫБАХ">
                <condition name="username">
                    <li>А вот это уже водный знак! Его покровители - Нептун и Юпитер. Символ - две рыбы, плывущие в разные стороны (Афродита и Эрос, превращённые в рыб), мечтательные и артистичные.</li>
		    <li>А вот это, <get name="username"/>, уже водный знак! Его покровители - Нептун и Юпитер. Символ - две рыбы, плывущие в разные стороны (Афродита и Эрос, превращённые в рыб), мечтательные и артистичные.</li>
                </condition>
            </li>
            <!-- ДЕФОЛТНЫЙ ОТВЕТ, ЕСЛИ ЗНАК НЕ ОПОЗНАН -->
            <li>
                Прости, я пока не могу рассказать об этом символе подробно. Но я точно распознаю все знаки зодиака!
            </li>
        </condition>
    </template>
</category>

<!-- АЛЬТЕРНАТИВНЫЕ ФОРМЫ ЗАПРОСА "РАССКАЖИ О X" -->
<category>
    <pattern>РАССКАЖИ ОБ *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>РАССКАЖИ ПРО *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>СКАЖИ ЧТО ТАКОЕ *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>СКАЖИ, КТО ТАКОЙ *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>ЧТО ТАКОЕ *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>КТО ТАКОЙ * ЗНАК</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>ИНФОРМАЦИЯ О *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>ИНФОРМАЦИЯ ОБ *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>
<category>
    <pattern>ИНФОРМАЦИЯ ПРО *</pattern>
    <template>
        <srai>РАССКАЖИ О <star/></srai>
    </template>
</category>

<!-- FOLLOW-UP QUESTIONS - ВОПРОСЫ БЕЗ ПОВТОРА ТЕМЫ, РАБОТАЮТ С ПЕРЕМЕННОЙ last_sign -->
<!-- Что ещё? -->
<category>
    <pattern>А ЧТО ЕЩЁ</pattern>
    <template>
        <condition name="last_sign">
            <li value="UNKNOWN">О чём именно? Сначала попроси рассказать о чём-нибудь.</li>
            <li value="ОВЕН|ОВНА|ОВНЕ">
                Интересный факт: миф об Овне связан с золотым руном, которое искали аргонавты. А ещё Овен — один из древнейших символов, встречающийся в шумерской культуре.
            </li>
            <li value="ТЕЛЕЦ|ТЕЛЬЦА|ТЕЛЬЦЕ">
                Интересный факт: созвездие Тельца содержит яркое звёздное скопление — Плеяды, которое видно невооружённым глазом и почиталось во многих древних культурах.
            </li>
            <li value="БЛИЗНЕЦЫ|БЛИЗНЕЦОВ|БЛИЗНЕЦАХ">
                Историческая справка: в мифологии Близнецы обычно ассоциируются с Кастором и Поллуксом, братьями, один из которых был смертным, а другой — бессмертным.
            </li>
            <li value="РАК|РАКА|РАКЕ">
                Историческая справка: связан с раком (крабом), который укусил Геракла за ногу во время его битвы с Лернейской гидрой. За помощь Гера богиня Гера поместила рака на небо.
            </li>
	   <li value="ЛЕВ|ЛЬВА|ЛЬВЕ">
                Историческая справка: созвездие Льва часто связывают с Немейским львом — первым из подвигов Геракла, которого невозможно было убить обычным оружием.
            </li>
	   <li value="ДЕВА|ДЕВЫ|ДЕВЕ">
                Историческая справка: часто ассоциируется с богиней урожая и плодородия Деметрой или ее дочерью Персефоной. Изображается с колосьями пшеницы.
            </li>
	    <li value="ВЕСЫ|ВЕСОВ|ВЕСАХ">
                Интересный факт: единственный знак, представленный неодушевленным предметом
            </li>
	    <li value="СКОРПИОН|СКОРПИОНА|СКОРПИОНЕ">
                Историческая справка: связан со скорпионом, которого послала богиня Артемида (или Гера), чтобы убить охотника Ориона. Все три персонажа (Орион, Скорпион и Артемида/Телец) оказались на небе, но в разных его частях.
            </li>
	    <li value="СТРЕЛЕЦ|СТРЕЛЬЦА|СТРЕЛЬЦЕ">
                Историческая справка: изображается как кентавр с луком. Часто отождествляется с мудрым кентавром Хироном (хотя в мифах это разные персонажи) или с Кротосом, изобретателем аплодисментов.
            </li>
	    <li value="КОЗЕРОГ|КОЗЕРОГА|КОЗЕРОГЕ">
                Историческая справка: изображается как морской козел (козел с рыбьим хвостом). Связан с богом Паном, который, спасаясь от чудовища Тифона, прыгнул в Нил и превратил свою нижнюю часть в рыбий хвост.
            </li>
	    <li value="ВОДОЛЕЙ|ВОДОЛЕЯ|ВОДОЛЕЕ">
                Историческая справка: часто отождествляется с Ганимедом — прекрасным троянским юношей, которого Зевс сделал виночерпием богов на Олимпе. Из его кувшина льется не вода, а нектар.
            </li>
	    <li value="РЫБЫ|РЫБ|РЫБАХ">
                Интересный факт: последний знак зодиака, символ единства, сострадания и растворения границ. Рыбы мечтательны, чувствительны, артистичны, обладают развитой эмпатией, но могут быть склонны к эскапизму.
            </li>
            <li>
                Кажется, я забыл, о каком символе мы говорили. Напомни, пожалуйста.
            </li>
        </condition>
    </template>
</category>
<category>
    <pattern>РАССКАЖИ ПОПОДРОБНЕЕ</pattern>
    <template>
        <srai>А ЧТО ЕЩЁ</srai>
    </template>
</category>
<category>
    <pattern>ЕЩЁ ИНФОРМАЦИЮ</pattern>
    <template>
        <srai>А ЧТО ЕЩЁ</srai>
    </template>
</category>
<category>
    <pattern>ПРОДОЛЖАЙ</pattern>
    <template>
        <srai>А ЧТО ЕЩЁ</srai>
    </template>
</category>
<category>
    <pattern>ЧТО ЕЩЁ</pattern>
    <template>
        <srai>А ЧТО ЕЩЁ</srai>
    </template>
</category>
<category>
    <pattern>ПОДРОБНЕЕ</pattern>
    <template>
        <srai>А ЧТО ЕЩЁ</srai>
    </template>
</category>

<!-- А о чём мы разговариваем? -->
<category>
    <pattern>А О ЧЁМ МЫ РАЗГОВАРИВАЕМ</pattern>
    <template>
        <condition name="last_sign">
            <li value="UNKNOWN">Мы ещё ни о чём конкретном не говорили. Спроси меня о знаке зодиака!</li>
            <li>О <get name="last_sign"/>.</li>
        </condition>
    </template>
</category>
<category>
    <pattern>О ЧЁМ РЕЧЬ</pattern>
    <template>
        <srai>А О ЧЁМ МЫ РАЗГОВАРИВАЕМ</srai>
    </template>
</category>

<!-- ПРИВЕТСТВИЕ С УЧЁТОМ ИМЕНИ -->
<category>
    <pattern>ПРИВЕТ</pattern>
    <template>
        <condition name="username">
            <li>Привет! Как тебя зовут?</li>
            <li value="*">Привет, <get name="username"/>! Рад снова тебя видеть.</li>
        </condition>
    </template>
</category>
<category>
    <pattern>ЗДРАВСТВУЙ</pattern>
    <template>
        <srai>ПРИВЕТ</srai>
    </template>
</category>
<category>
    <pattern>ХАЙ</pattern>
    <template>
        <srai>ПРИВЕТ</srai>
    </template>
</category>
<category>
    <pattern>ДОБРЫЙ ДЕНЬ</pattern>
    <template>
        <srai>ПРИВЕТ</srai>
    </template>
</category>

<!-- ПРОЩАНИЕ -->
<category>
    <pattern>ПОКА</pattern>
    <template>
        <condition name="username">
            <li>Пока! Возвращайся с новыми вопросами о звёздах.</li>
            <li value="*">Пока, <get name="username"/>! Возвращайся с новыми вопросами о звёздах.</li>
        </condition>
    </template>
</category>
<category>
    <pattern>ДО СВИДАНИЯ</pattern>
    <template>
        <srai>ПОКА</srai>
    </template>
</category>
</aiml>